<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="shift_pick_app.Views.RegisterStoreInPage"
             NavigationPage.HasNavigationBar="False" >

    <ScrollView>
        <StackLayout>
            <StackLayout x:Name="mainContent">
                
                <StackLayout Grid.Row="0" BackgroundColor=" Transparent" Orientation="Horizontal" Margin="10">
                    <Button FontFamily="FontAwesome6Solid" Text="&#xf048; 戻る" Background="Gray" TextColor=" White"  HorizontalOptions="StartAndExpand" CornerRadius="25" WidthRequest="120" HeightRequest="50" FontSize="18" Margin="25,0,0,0" Clicked="OnButtonBackClick"/>
                    <Button FontFamily="FontAwesome6Solid" Text="&#xe09a; 登録" Background="#F56462" TextColor=" White" HorizontalOptions="EndAndExpand" CornerRadius="25" WidthRequest="120" HeightRequest="50" FontSize="18" Margin="0,0,25,0" Clicked="OnButtonRegisterClick"/>
                </StackLayout>
                <Frame CornerRadius="0" BorderColor="Transparent" Padding="10">
                    <StackLayout HorizontalOptions="Center">
                        <Label 
                             Text="応募画面"
                             FontSize="20" />
                    </StackLayout>
                </Frame>

                <Frame BackgroundColor="#FD5A00" CornerRadius="0" BorderColor="#FD5A00" HeightRequest="50" Padding="0">
                    <StackLayout HorizontalOptions="Center">
                        <Label 
                             Text="ユーザーID: xxxxxx"
                             FontSize="18" TextColor="#fff" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" />
                    </StackLayout>
                </Frame>
                <StackLayout Background="#fff" Padding="20, 15, 20, 5">
                    <Label 
                        Text="日付　　　事業所　　　　　　　　　　選択"
                        FontSize="16" />        
                </StackLayout>
                <Border Stroke="Black" StrokeThickness="2" Background="White" Padding="0, 0, 0, 0" Margin="10, 10, 10, 5">
                    <CollectionView HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="10">

                                    <!-- 左側：アイテム名 -->
                                    <Label Grid.Column="0"
                                    Text="{Binding}"
                                    FontSize="18"
                                    VerticalOptions="Center"/>

                                    <!-- 右側：ボタン -->
                                    <Button Grid.Column="1"
                                    Text="予約"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                                <x:String>mm/dd　　 ○○事業所　</x:String>
                            </x:Array>
                        </CollectionView.ItemsSource>
                    </CollectionView>
                </Border>
                
                <StackLayout Background="#fff" Padding="20, 5, 20, 5">
                    <Label 
                        Text="希望事業所"
                        FontSize="16" />
                    <Label x:Name="scanTextResult" Padding="10, 15, 10, 15" FontAttributes="Bold" BackgroundColor="#f2f2f2" FontSize="16" Margin="0, 10, 0, 0"
                           Text="○○, ○○, ○○"/>
                </StackLayout>
        

                <FlexLayout Direction="Row" JustifyContent="SpaceAround" AlignItems="Center" Margin="0,20,0,20" Padding="0,0,0,10">
                    <Button x:Name="numberOfBoxListBtn" FontFamily="FontAwesome6Solid" Text="希望事業所登録" TextColor=" White"  HorizontalOptions="StartAndExpand" CornerRadius="10"  HeightRequest="50" FontSize="15" Margin="10, 5, 0, 0" Clicked="OnTotalNumberOfBoxesBtnClicked"/>
                    <Button x:Name="historyListBtn" FontFamily="FontAwesome6Solid" Text="選択" TextColor=" White" HorizontalOptions="EndAndExpand" CornerRadius="10" HeightRequest="50" FontSize="15" Margin="0, 5, 10, 0" Clicked="OnHistoryListBtnBClicked"/>
                </FlexLayout>

                
            </StackLayout>

            <StackLayout x:Name="loadingOverLay" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                <ActivityIndicator x:Name="loadingIndicator" IsVisible="False" Color="#FD5A00" />
            </StackLayout>  
        </StackLayout>

    </ScrollView>

</ContentPage>