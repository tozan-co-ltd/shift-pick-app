<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mar_sumaken_app.Views.MenuPage"
             BackgroundColor="#f2f2f2"
              NavigationPage.HasBackButton="False"
              Shell.NavBarIsVisible="False"
              NavigationPage.HasNavigationBar="False"
             Title="メニュー">
    <FlyoutPage.Flyout>
        <ContentPage Title="メニュー">
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <VerticalStackLayout>
                        <StackLayout Margin="0" Padding="0">
                            <Frame BackgroundColor="#f2f2f2" CornerRadius="0" BorderColor="Transparent">
                                <Label Text="ログイン情報" FontSize="26" Padding="0,20,0,20" HorizontalOptions="Center" FontAttributes="Bold"/>
                            </Frame>
                        </StackLayout>
                        <StackLayout>
                            <Label Text="会社コード" FontAttributes="Bold" Padding="15, 10, 0, 5" FontSize="20"/>
                            <StackLayout>
                                <Label x:Name="companyCode" Text="Item1" Margin="25,0,0,10" FontSize="18"/>
                                <BoxView HeightRequest="1" Color="#ccc" HorizontalOptions="FillAndExpand" />
                            </StackLayout>

                            <Label Text="ログアウトID" FontAttributes="Bold" Padding="15, 10, 0, 5" FontSize="20"/>
                            <StackLayout>
                                <Label x:Name="loginId" Text="Item2"  Margin="25,0,0,10" FontSize="20"/>
                                <BoxView HeightRequest="1" Color="#ccc" HorizontalOptions="FillAndExpand" />
                            </StackLayout>

                        </StackLayout>
                    </VerticalStackLayout>

                    <Button Text="ログアウト" Clicked="OnLogoutClicked" BackgroundColor="#FD5A00" WidthRequest="200" HeightRequest="60" FontSize="22" VerticalOptions="EndAndExpand"  HorizontalOptions="FillAndExpand" Margin="0, 0, 0, 50" FontAttributes="Bold"/>
                </Grid>
            </Grid>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <ContentPage>
                    <NavigationPage.TitleView>
                        <StackLayout Margin="0" Padding="0">
                            <Label Text="メニュー" TextColor="#fff" ZIndex="9999" FontSize="22" Margin="0, 13, 0, 0" FontAttributes="Bold" Padding="0"/>
                        </StackLayout>
                    </NavigationPage.TitleView>

                    <StackLayout BackgroundColor="#f2f2f2">
                        <StackLayout x:Name="mainContent" BackgroundColor="#fff">
                            <Frame BackgroundColor="#FD5A00" CornerRadius="0" BorderColor="#FD5A00">
                                <StackLayout HorizontalOptions="Center">
                                    <FlexLayout Direction="Row" JustifyContent="Center" Padding="0" Margin="0">
                                        <Label Text="山田太郎" FontSize="18" TextColor="#fff"/>
                                        <Label Text="さん" FontSize="14" TextColor="#fff" Padding="0, 5, 0, 0"/>
                                        <Label Text="西尾物流センター" FontSize="18" TextColor="#fff" Margin="5, 0, 0 ,0"/>
                                        <Label Text="で作業中" FontSize="14" TextColor="#fff" Padding="0, 5, 0, 0"/>
                                    </FlexLayout>
                                </StackLayout>
                            </Frame>
                            <ListView x:Name="myListView" ItemsSource="{Binding Items}" RowHeight="90" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <StackLayout Orientation="Horizontal" Padding="30,0,0,0" Background="#fff">
                                                <Label Text="{Binding Id}" VerticalOptions="CenterAndExpand" FontSize="26"/>
                                                <Label Text="." VerticalOptions="CenterAndExpand" FontSize="26"/>
                                                <Label Text="{Binding Title}" VerticalOptions="CenterAndExpand" Margin="20,0,0,0"  FontSize="26"/>
                                            </StackLayout>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackLayout>
                        <StackLayout x:Name="loadingOverLay" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                            <ActivityIndicator x:Name="loadingIndicator" IsVisible="False" Color="#FD5A00" />
                        </StackLayout>
                    </StackLayout>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>