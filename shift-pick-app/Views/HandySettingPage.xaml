<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:shift_pick_app.ViewModels"
             x:Class="shift_pick_app.Views.HandySettingPage"
             x:DataType="vm:HandySettingPageViewModel"
             Title="ハンディ設定">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- 接続先 -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="接続先" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding ApiUrl}"
                               Keyboard="Url"
                               IsTextPredictionEnabled="False" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- テーマ（デモ用） -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="テーマ（デモ用）" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Picker Title="テーマ"
                                ItemsSource="{Binding ThemeNames}"
                                SelectedIndex="{Binding SelectedThemeIndex}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
