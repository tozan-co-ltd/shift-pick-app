<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mar_sumaken_app.Views.LoadingPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             Title="LoadingPage">
        <StackLayout x:Name="loadingOverLay" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
            <ActivityIndicator x:Name="loadingIndicator" IsVisible="True" IsRunning="True" Color="#FD5A00" />
        </StackLayout>
</ContentPage>