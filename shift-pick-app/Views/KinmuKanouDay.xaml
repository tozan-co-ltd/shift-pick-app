<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:shift_pick_app.ViewModels"
             xmlns:calendar="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             xmlns:shared="clr-namespace:shift_pick_app.Views.Shared"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="shift_pick_app.Views.KinmuKanouDay"
             x:DataType="vm:KinmuKanouDayViewModel"
             Title="勤務可能日">

    <ContentPage.Resources>
        <!-- 曜日ラベル（タップで曜日をまとめて選択） -->
        <Style x:Key="CalendarDayTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="MPLUSRounded1cBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style x:Key="CalendarWeekendTitle" TargetType="Label" BasedOn="{StaticResource CalendarDayTitle}">
            <Setter Property="TextColor" Value="{DynamicResource Error}" />
        </Style>

        <!-- ライブラリの曜日ラベルはタップできないため非表示にし、上の独自ラベルを使う -->
        <Style x:Key="CalendarHiddenTitle" TargetType="Label">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- 当月／翌月の切り替えボタン -->
        <Style x:Key="MonthTab" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="12">

                <Border Style="{StaticResource Card}" Padding="0,0,0,12">
                    <VerticalStackLayout Spacing="8">
                        <!-- 当月／翌月（ライブラリのヘッダーは非表示） -->
                        <Grid ColumnDefinitions="*,*">
                            <Button Text="{Binding ThisMonthText}"
                                    Style="{StaticResource MonthTab}"
                                    Command="{Binding ShowThisMonthCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsNextMonth}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Text="{Binding NextMonthText}"
                                    Style="{StaticResource MonthTab}"
                                    Command="{Binding ShowNextMonthCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsNextMonth}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <!-- テスト用：独自カレンダー（フライアウトの切り替えで表示） -->
                        <shared:MonthCalendar IsVisible="{Binding UseCustomCalendar}"
                                              ShownMonth="{Binding ShownDate}"
                                              MinimumDate="{Binding MinimumDate}"
                                              MaximumDate="{Binding MaximumDate}"
                                              SelectedDates="{Binding SelectedDates, Mode=TwoWay}"
                                              RegisteredDates="{Binding RegisteredDates}"
                                              Holidays="{Binding Holidays}" />

                        <!-- Plugin.Maui.Calendar（独自カレンダーの確認後に削除） -->
                        <VerticalStackLayout IsVisible="{Binding UsePluginCalendar}" Spacing="8">
                            <!-- 曜日（日曜始まり）：列幅はライブラリと同じ7等分 -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                <Label Grid.Column="0" Text="日" Style="{StaticResource CalendarWeekendTitle}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectWeekdayCommand}" CommandParameter="{x:Static sys:DayOfWeek.Sunday}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="1" Text="月" Style="{StaticResource CalendarDayTitle}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectWeekdayCommand}" CommandParameter="{x:Static sys:DayOfWeek.Monday}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="2" Text="火" Style="{StaticResource CalendarDayTitle}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectWeekdayCommand}" CommandParameter="{x:Static sys:DayOfWeek.Tuesday}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="3" Text="水" Style="{StaticResource CalendarDayTitle}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectWeekdayCommand}" CommandParameter="{x:Static sys:DayOfWeek.Wednesday}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="4" Text="木" Style="{StaticResource CalendarDayTitle}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectWeekdayCommand}" CommandParameter="{x:Static sys:DayOfWeek.Thursday}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="5" Text="金" Style="{StaticResource CalendarDayTitle}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectWeekdayCommand}" CommandParameter="{x:Static sys:DayOfWeek.Friday}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="6" Text="土" Style="{StaticResource CalendarWeekendTitle}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectWeekdayCommand}" CommandParameter="{x:Static sys:DayOfWeek.Saturday}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <calendar:MultiSelectionCalendar
                                Culture="{Binding Culture}"
                                ShownDate="{Binding ShownDate, Mode=TwoWay}"
                                SelectedDates="{Binding SelectedDates, Mode=TwoWay}"
                                MinimumDate="{Binding MinimumDate}"
                                MaximumDate="{Binding MaximumDate}"
                                Events="{Binding CalendarEvents}"
                                HeaderSectionVisible="False"
                                FooterSectionVisible="False"
                                SwipeToChangeMonthEnabled="False"
                                SwipeUpToHideEnabled="False"
                                OtherMonthDayIsVisible="False"
                                DaysTitleLabelStyle="{StaticResource CalendarHiddenTitle}"
                                WeekendTitleStyle="{StaticResource CalendarHiddenTitle}"
                                DayViewSize="44"
                                DayViewCornerRadius="0"
                                DeselectedDayTextColor="{DynamicResource OnSurface}"
                                WeekendDayColor="{DynamicResource Error}"
                                DisabledDayColor="{DynamicResource Outline}"
                                SelectedDayBackgroundColor="{DynamicResource Primary}"
                                SelectedDayTextColor="{DynamicResource OnPrimary}"
                                SelectedTodayTextColor="{DynamicResource OnPrimary}"
                                TodayTextColor="{DynamicResource Primary}"
                                TodayOutlineColor="{DynamicResource Primary}"
                                TodayFillColor="Transparent"
                                EventIndicatorType="Background"
                                EventIndicatorColor="{DynamicResource OnSuccessFixedVariant}"
                                EventIndicatorSelectedColor="{DynamicResource OnSuccessFixedVariant}"
                                EventIndicatorTextColor="{DynamicResource SuccessFixed}"
                                EventIndicatorSelectedTextColor="{DynamicResource SuccessFixed}" />
                        </VerticalStackLayout>

                        <!-- 凡例 -->
                        <HorizontalStackLayout Spacing="16" Padding="12,0" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="{DynamicResource Primary}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="選択中" FontSize="14" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="{DynamicResource OnSuccessFixedVariant}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="登録済み（変更不可）" FontSize="14" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Error}"
                       IsVisible="{Binding IsErrorMessageVisible}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Button Text="登録"
                        Command="{Binding RegisterCommand}"
                        HorizontalOptions="Center"
                        WidthRequest="200" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- 登録中のオーバーレイ -->
        <shared:LoadingOverlay IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
