<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:shift_pick_app.ViewModels"
             x:Class="shift_pick_app.Views.LoginPage"
             x:DataType="vm:LoginPageViewModel"
             Title="ログイン">

    <ScrollView>
        <Border Style="{StaticResource Card}" Margin="16" VerticalOptions="Center">
            <VerticalStackLayout Spacing="12">

                <!-- アプリアイコン -->
                <Border WidthRequest="120"
                        HeightRequest="120"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 30"
                        Stroke="Transparent"
                        BackgroundColor="{DynamicResource SurfaceContainer}">
                    <Image Source="appicon.png" />
                </Border>

                <!-- アプリ名 + 説明 -->
                <Label Text="ShiftPick"
                       FontFamily="MPLUSRounded1cBold"
                       FontSize="26"
                       TextColor="{DynamicResource Primary}"
                       HorizontalOptions="Center" />
                <Label Text="湘南プラス利用アプリ"
                       FontSize="16"
                       TextColor="{DynamicResource Primary}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,8" />

                <!-- ユーザーID -->
                <Border Style="{StaticResource InputBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="&#xf007;"
                               FontFamily="FontAwesome6Solid"
                               FontSize="20"
                               TextColor="{DynamicResource OnSurfaceVariant}"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding UserId}"
                               Keyboard="Email"
                               Placeholder="ユーザーID"
                               IsTextPredictionEnabled="False"
                               FontSize="20" />
                    </Grid>
                </Border>

                <!-- パスワード -->
                <Border Style="{StaticResource InputBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="&#xf023;"
                               FontFamily="FontAwesome6Solid"
                               FontSize="20"
                               TextColor="{DynamicResource OnSurfaceVariant}"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Text="{Binding Password}"
                               IsPassword="True"
                               Placeholder="パスワード"
                               FontSize="20" />
                    </Grid>
                </Border>

                <!-- エラーメッセージ -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Error}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- ログイン -->
                <Button Text="ログイン"
                        Command="{Binding LoginCommand}"
                        FontSize="24" />

                <!-- パスワードリセット -->
                <Label Text="パスワードをお忘れの場合はこちら"
                       TextColor="{DynamicResource Primary}"
                       TextDecorations="Underline"
                       HorizontalOptions="Center"
                       Padding="0,12">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
