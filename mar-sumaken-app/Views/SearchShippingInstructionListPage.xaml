<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mar_sumaken_app.Views.SearchShippingInstructionListPage"
             NavigationPage.HasNavigationBar="False"
             Background="#f2f2f2">

    <ContentPage.Resources>
        <Style x:Key="CustomRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="BackgroundColor" Value="#f2f2f2" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="BorderColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="WidthRequest" Value="60" />

            <Style.Triggers>
                <Trigger TargetType="RadioButton" Property="IsChecked" Value="True">
                    <Setter Property="BorderColor" Value="#FD5A00" />
                    <Setter Property="BorderWidth" Value="2" />
                    <Setter Property="Background" Value="#f2f2f2" />
                    <!-- Change other properties as needed when checked -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TripButtonStyle" TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="WidthRequest" Value="60" />
            <Setter Property="HeightRequest" Value="50" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout>
        <StackLayout Grid.Row="0" BackgroundColor=" Transparent" Orientation="Horizontal" Margin="10">
            <Button FontFamily="FontAwesome6Solid" Text="&#xf048; 戻る" Background="Gray" TextColor=" White"  HorizontalOptions="StartAndExpand" CornerRadius="25" WidthRequest="120" HeightRequest="50" FontSize="16" Margin="25,0,0,0" Clicked="OnBackButtonClicked"/>
        </StackLayout>
        <Frame CornerRadius="0" BorderColor="Transparent" Background="#f2f2f2" Margin="0" Padding="10">
            <StackLayout HorizontalOptions="Center">
                <Label 
                Text="出庫"
                FontSize="20"
                />
            </StackLayout>
        </Frame>

        <Frame BorderColor="Transparent">
            <StackLayout>
                <Label Text="出荷指示リスト検索" FontSize="18" HorizontalOptions="Center"/>
                <Frame CornerRadius="0"  BorderColor="Transparent">

                    <StackLayout Spacing="5" VerticalOptions="End">
                        <Label Text="納入先" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start"  Margin="0" FontSize="16"/>
                        <Frame Padding="0" BackgroundColor="#f2f2f2" BorderColor="Transparent" CornerRadius="0">
                            <StackLayout  Margin="0" Padding="10, 0, 10,0" BackgroundColor="#f2f2f2">
                                <Picker x:Name="receiver" SelectedIndexChanged="OnReceiverChanged" VerticalOptions="CenterAndExpand" FontSize="15" FontAttributes="Bold" Title="納入先"/>
                            </StackLayout>
                        </Frame>
                        
                        <Label Text="納入指示日" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start"  Margin="0,5,0,0" FontSize="16"/>
                        <Frame Padding="5,0,5,0" BackgroundColor="#f2f2f2"  Margin="0,0,0,5" BorderColor="Transparent"  CornerRadius="0">
                            <DatePicker x:Name="datePicker" FontSize="16" HorizontalOptions="FillAndExpand" FontAttributes="Bold" Format="yyyy/MM/dd"/>
                        </Frame>

                        <Label Text="納入場所" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" Margin="0,5,0,0" FontSize="16"/>
                        <Frame Padding="0" BackgroundColor="#f2f2f2" BorderColor="Transparent" CornerRadius="0">
                            <StackLayout  Margin="0" Padding="10, 0, 10,0" BackgroundColor="#f2f2f2">
                                <Picker x:Name="place" SelectedIndexChanged="OnPlaceChanged" VerticalOptions="CenterAndExpand" FontSize="16" FontAttributes="Bold" Title="納入場所"/>
                            </StackLayout>
                        </Frame>

                        <Label Text="便" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start" FontSize="16" Margin="0,5,0,0"/>
                        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" Margin="0,0,0,15" Padding="0">
                            <Button Text="1" x:Name="trip1" Clicked="OnTripButtonClicked" BackgroundColor="#008577" TextColor="White" Style="{StaticResource TripButtonStyle}" />
                            <Button Text="2" x:Name="trip2" Clicked="OnTripButtonClicked" BackgroundColor="Gray" TextColor="White" Style="{StaticResource TripButtonStyle}"/>
                            <Button Text="3" x:Name="trip3" Clicked="OnTripButtonClicked" BackgroundColor="Gray" TextColor="White" Style="{StaticResource TripButtonStyle}"/>
                            <Button Text="4" x:Name="trip4" Clicked="OnTripButtonClicked" BackgroundColor="Gray" TextColor="White" Style="{StaticResource TripButtonStyle}"/>
                        </FlexLayout>

                        <Button Visual="Material" Text="検索"  BackgroundColor="#FD5A00" HeightRequest="60" FontSize="22" Clicked="OnSearchButtonClicked" Margin="0"/>
                    </StackLayout>
                </Frame>
            </StackLayout>
        </Frame>
    </VerticalStackLayout>

</ContentPage>