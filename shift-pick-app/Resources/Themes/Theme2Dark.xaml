<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="shift_pick_app.Themes.Theme2Dark">
    <!-- メインカラー。主要ボタンや主要な操作 -->
    <Color x:Key="Primary">#AFC6FF</Color>
    <!-- Primary上の文字・アイコン -->
    <Color x:Key="OnPrimary">#142F60</Color>
    <!-- Primaryの淡い背景。選択中の項目や強調カード -->
    <Color x:Key="PrimaryContainer">#2D4578</Color>
    <!-- PrimaryContainer上の文字・アイコン -->
    <Color x:Key="OnPrimaryContainer">#D9E2FF</Color>
    <!-- 補助アクセント。サブボタンやフィルター -->
    <Color x:Key="Secondary">#BFC6DC</Color>
    <!-- Secondary上の文字・アイコン -->
    <Color x:Key="OnSecondary">#293042</Color>
    <!-- 補助的な背景。チップやナビゲーションの選択状態 -->
    <Color x:Key="SecondaryContainer">#404659</Color>
    <!-- SecondaryContainer上の文字・アイコン -->
    <Color x:Key="OnSecondaryContainer">#DBE2F9</Color>
    <!-- 対比アクセント。補足情報やバッジ -->
    <Color x:Key="Tertiary">#8BD0F0</Color>
    <!-- Tertiary上の文字・アイコン -->
    <Color x:Key="OnTertiary">#003546</Color>
    <!-- Tertiaryの淡い背景。補足情報のカード -->
    <Color x:Key="TertiaryContainer">#004D64</Color>
    <!-- TertiaryContainer上の文字・アイコン -->
    <Color x:Key="OnTertiaryContainer">#BEE9FF</Color>
    <!-- エラーの文字・アイコン・枠線 -->
    <Color x:Key="Error">#FFB4AB</Color>
    <!-- Error上の文字・アイコン -->
    <Color x:Key="OnError">#690005</Color>
    <!-- エラーメッセージの背景 -->
    <Color x:Key="ErrorContainer">#93000A</Color>
    <!-- ErrorContainer上の文字・アイコン -->
    <Color x:Key="OnErrorContainer">#FFDAD6</Color>
    <!-- 画面全体の背景 -->
    <Color x:Key="Background">#121318</Color>
    <!-- Background上の本文文字 -->
    <Color x:Key="OnBackground">#E2E2E9</Color>
    <!-- カードやシートなど面の背景 -->
    <Color x:Key="Surface">#121318</Color>
    <!-- Surface上の文字・アイコン -->
    <Color x:Key="OnSurface">#E2E2E9</Color>
    <!-- 入力欄など、少し変化をつけた面 -->
    <Color x:Key="SurfaceVariant">#44464F</Color>
    <!-- SurfaceVariant上の補助文字。ラベルやヒント -->
    <Color x:Key="OnSurfaceVariant">#C5C6D0</Color>
    <!-- はっきりした境界線。入力欄の枠 -->
    <Color x:Key="Outline">#8F9099</Color>
    <!-- 控えめな境界線。区切り線 -->
    <Color x:Key="OutlineVariant">#44464F</Color>
    <!-- モーダル表示時の背景オーバーレイ -->
    <Color x:Key="Scrim">#000000</Color>
    <!-- 反転した面。Snackbarなど -->
    <Color x:Key="InverseSurface">#E2E2E9</Color>
    <!-- InverseSurface上の文字 -->
    <Color x:Key="InverseOnSurface">#2F3036</Color>
    <!-- InverseSurface上で使うPrimaryのアクセント -->
    <Color x:Key="InversePrimary">#465D91</Color>
    <!-- テーマ切替えで変わらない固定のPrimary面 -->
    <Color x:Key="PrimaryFixed">#D9E2FF</Color>
    <!-- PrimaryFixed上の文字 -->
    <Color x:Key="OnPrimaryFixed">#001944</Color>
    <!-- PrimaryFixedより一段濃い固定色 -->
    <Color x:Key="PrimaryFixedDim">#AFC6FF</Color>
    <!-- PrimaryFixed上の補助文字 -->
    <Color x:Key="OnPrimaryFixedVariant">#2D4578</Color>
    <!-- テーマ切替えで変わらない固定のSecondary面 -->
    <Color x:Key="SecondaryFixed">#DBE2F9</Color>
    <!-- SecondaryFixed上の文字 -->
    <Color x:Key="OnSecondaryFixed">#141B2C</Color>
    <!-- SecondaryFixedより一段濃い固定色 -->
    <Color x:Key="SecondaryFixedDim">#BFC6DC</Color>
    <!-- SecondaryFixed上の補助文字 -->
    <Color x:Key="OnSecondaryFixedVariant">#404659</Color>
    <!-- テーマ切替えで変わらない固定のTertiary面 -->
    <Color x:Key="TertiaryFixed">#BEE9FF</Color>
    <!-- TertiaryFixed上の文字 -->
    <Color x:Key="OnTertiaryFixed">#001F2A</Color>
    <!-- TertiaryFixedより一段濃い固定色 -->
    <Color x:Key="TertiaryFixedDim">#8BD0F0</Color>
    <!-- TertiaryFixed上の補助文字 -->
    <Color x:Key="OnTertiaryFixedVariant">#004D64</Color>
    <!-- 暗めの面。非アクティブ領域 -->
    <Color x:Key="SurfaceDim">#121318</Color>
    <!-- 明るめの面 -->
    <Color x:Key="SurfaceBright">#38393E</Color>
    <!-- 最も低い階層のコンテナ背景 -->
    <Color x:Key="SurfaceContainerLowest">#0C0E13</Color>
    <!-- 低い階層のコンテナ背景 -->
    <Color x:Key="SurfaceContainerLow">#1A1B20</Color>
    <!-- 標準のコンテナ背景。カードやリスト -->
    <Color x:Key="SurfaceContainer">#1E1F25</Color>
    <!-- 高い階層のコンテナ。ダイアログやメニュー -->
    <Color x:Key="SurfaceContainerHigh">#282A2F</Color>
    <!-- 最も高い階層のコンテナ。ポップアップや強調 -->
    <Color x:Key="SurfaceContainerHighest">#33353A</Color>
</ResourceDictionary>
