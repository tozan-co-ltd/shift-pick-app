<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mar_sumaken_app.Views.LoginPage"
             NavigationPage.HasBackButton="False"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Background="#F2F2F2"
             Title="ログイン">

    <ContentPage.Resources>
        <!--ラベル:アプリ名-->
        <Style x:Key="LabelTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Title" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="TextColor" Value="{StaticResource Key=Secondary}"/>
        </Style>

        <Style TargetType="Frame">
            <Setter Property="HasShadow" Value="False" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Rounded Mplus 1c" />
            <Setter Property="TextColor" Value="{DynamicResource ButtonTextColor}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="60" />
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
            <Setter Property="FontSize" Value="Large" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout>
        <FlexLayout Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center" Margin="0,0,0,20"  BackgroundColor="#000" HeightRequest="60" >
            <Label Text="ログイン" TextColor="#fff" FontSize="22" FontAttributes="Bold" Margin="6, 0, 0, 0"/>
            <Button Visual="Material"  Text="設定" BackgroundColor="Transparent" TextColor="#fff" VerticalOptions="StartAndExpand" FontAttributes="Bold" Clicked="OnSettingClicked">
                <Button.ImageSource>
                    <FontImageSource FontFamily="FontAwesome6Solid" Glyph="&#xf013;" Color="#fff" Size="Large" />
                </Button.ImageSource>
            </Button>
        </FlexLayout>

        <StackLayout x:Name="loginContent" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" >
            <ScrollView>
                <Frame  BackgroundColor="#fff" CornerRadius="10" Margin="10, 0, 10, 0">
                    <StackLayout>
                        <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
                            <Label Text="在庫管理システム" FontSize="26" TextColor="#FD5A00" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Text="ハンディアプリ(仮)" FontSize="26" TextColor="#FD5A00" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label x:Name="appVersion" FontSize="24" Margin="0, 10, 0, 0" HorizontalOptions="Center"/>
                        </StackLayout>

                        <Frame WidthRequest="120" CornerRadius="30" HeightRequest="120"
                             Padding="0"
                             BackgroundColor="#E6E7EE">
                            <Image Source="appicon.png" />
                        </Frame>

                        <StackLayout Spacing="5" VerticalOptions="End"  Margin="0, 10, 0, 0">
                            <Label Text="ログインID" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Start"  Margin="0,10,0,0" FontSize="20"/>
                            <Frame Padding="10,0,10,0" CornerRadius="10" BackgroundColor="#f2f2f2" Margin="0,0,0,10">
                                <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal" VerticalOptions="CenterAndExpand">
                                    <Entry x:Name="txtLoginId" FontSize="26" VerticalOptions="CenterAndExpand" HorizontalTextAlignment="Center" HorizontalOptions="FillAndExpand" IsTextPredictionEnabled="False"/>
                                </StackLayout>
                            </Frame>
                            <Label x:Name="loginError" FontSize="15" TextColor="Red" HorizontalOptions="Center" Margin="0,0,0,20"/>
                            <StackLayout Spacing="20" Margin="0, 0, 0, 10">
                                <StackLayout>
                                    <Button Visual="Material" Text="ログイン"  BackgroundColor="#FD5A00" Clicked="OnLoginClicked" FontSize="28" FontAttributes="Bold"/>
                                </StackLayout>
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Frame>
            </ScrollView>
        </StackLayout>
        <StackLayout x:Name="loadingOverLay" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">
            <ActivityIndicator x:Name="loadingIndicator" IsVisible="False" Color="#FD5A00" />
        </StackLayout>
    </VerticalStackLayout>

</ContentPage>