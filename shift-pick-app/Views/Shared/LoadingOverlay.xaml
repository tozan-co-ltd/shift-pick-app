<?xml version="1.0" encoding="utf-8" ?>
<!--
    処理中のオーバーレイ（画面全体を覆い、タップを遮る）。スピナーの下にヒント（Message、省略可）を表示
    使い方：画面のルート Grid の最後の子に置き、IsVisible を IsBusy、Message を BusyMessage にバインドする
    例：   <shared:LoadingOverlay IsVisible="{Binding IsBusy}" Message="{Binding BusyMessage}" />
    背景は画面の背景色を半透明で重ねる（ライト・ダークどちらでもヒントの文字が読める）
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="shift_pick_app.Views.Shared.LoadingOverlay"
             IsVisible="False">
    <Grid>
        <BoxView Color="{DynamicResource Background}" Opacity="0.8" />
        <VerticalStackLayout Spacing="12" Padding="24" VerticalOptions="Center">
            <ActivityIndicator IsRunning="True"
                               Color="{DynamicResource Primary}"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center" />
            <Label x:Name="messageLabel"
                   IsVisible="False"
                   FontSize="16"
                   TextColor="{DynamicResource OnBackground}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
