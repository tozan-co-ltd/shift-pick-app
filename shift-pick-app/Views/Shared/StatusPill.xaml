<?xml version="1.0" encoding="utf-8" ?>
<!--
    ステータスのピル（予約：ニュートラル・砂時計 / 確定：Success・チェック / NG：Error・バツ）
    アイコンは色が見分けにくい場合でもステータスが分かるように付ける
    使い方：<shared:StatusPill Status="{Binding Status}" Text="{Binding StatusLabel}" />
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="shift_pick_app.Views.Shared.StatusPill"
             HorizontalOptions="Start"
             VerticalOptions="Center">
    <Border x:Name="pill"
            Stroke="Transparent"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            Padding="10,2,12,2">
        <HorizontalStackLayout Spacing="6">
            <Label x:Name="icon"
                   FontFamily="FontAwesome6Solid"
                   FontSize="12"
                   VerticalOptions="Center" />
            <Label x:Name="label"
                   FontFamily="MPLUSRounded1cBold"
                   FontSize="14"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
