<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:shift_pick_app.ViewModels"
             xmlns:shared="clr-namespace:shift_pick_app.Views.Shared"
             x:Class="shift_pick_app.Views.KinmuKanouDay"
             x:DataType="vm:KinmuKanouDayViewModel"
             Title="勤務可能日">

    <ContentPage.Resources>
        <!-- 当月／翌月の切り替えボタン -->
        <Style x:Key="MonthTab" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </ContentPage.Resources>

    <!-- 本体（スクロール）＋ 下部固定の登録 -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="12">

                <Border Style="{StaticResource Card}" Padding="0,0,0,12">
                    <VerticalStackLayout Spacing="8">
                        <!-- 当月／翌月 -->
                        <Grid ColumnDefinitions="*,*">
                            <Button Text="{Binding ThisMonthText}"
                                    Style="{StaticResource MonthTab}"
                                    Command="{Binding ShowThisMonthCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsNextMonth}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Text="{Binding NextMonthText}"
                                    Style="{StaticResource MonthTab}"
                                    Command="{Binding ShowNextMonthCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsNextMonth}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <!-- カレンダー（曜日タップでまとめて選択） -->
                        <shared:MonthCalendar ShownMonth="{Binding ShownDate}"
                                              MinimumDate="{Binding MinimumDate}"
                                              MaximumDate="{Binding MaximumDate}"
                                              SelectedDates="{Binding SelectedDates, Mode=TwoWay}"
                                              RegisteredDates="{Binding RegisteredDates}"
                                              Holidays="{Binding Holidays}" />

                        <!-- 凡例 -->
                        <HorizontalStackLayout Spacing="16" Padding="12,0" HorizontalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="{DynamicResource Primary}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="選択中" FontSize="14" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <BoxView Color="{DynamicResource OnSuccessFixedVariant}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="登録済み（変更不可）" FontSize="14" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>

                        <!-- 曜日まとめ選択のヒント（カレンダーの外、凡例の下） -->
                        <Label FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Padding="12,0" >
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="&#xf0eb;"
                                          FontFamily="FontAwesome6Solid"
                                          TextColor="{DynamicResource OnSurfaceVariant}" />
                                    <Span Text=" " />
                                    <Span Text="曜日をタップするとまとめて選択できます"
                                          TextColor="{DynamicResource OnSurfaceVariant}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 下部固定：エラー + 登録（選択中の日数） -->
        <VerticalStackLayout Grid.Row="1">
            <BoxView HeightRequest="1" />
            <VerticalStackLayout Padding="12,8,12,12" Spacing="8">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Error}"
                       IsVisible="{Binding IsErrorMessageVisible}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Button Text="{Binding RegisterButtonText}"
                        shared:ButtonIcon.Glyph="&#xe09a;"
                        Command="{Binding RegisterCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- 画面遷移・登録中のオーバーレイ -->
        <shared:LoadingOverlay Grid.RowSpan="2" IsVisible="{Binding IsBusy}" Message="{Binding BusyMessage}" />
    </Grid>
</ContentPage>
