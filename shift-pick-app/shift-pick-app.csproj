<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>shift_pick_app</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- アプリ名 -->
		<ApplicationTitle>Shift Pick</ApplicationTitle>

		<!-- アプリ識別子 -->
		<ApplicationId>jp.co.tozan.shift_pick_app</ApplicationId>

		<!-- バージョン -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>	
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <ApplicationId>jp.co.tozan.shift-pick-app</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net9.0-ios'">
	  <CodesignKey>Apple Development: Created via API (V9FG95H3Q9)</CodesignKey>
	  <CodesignProvision>VS: jp.co.tozan.shift-pick-app Development</CodesignProvision>
	  <ProvisioningType>manual</ProvisioningType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <ApplicationId>jp.co.tozan.shift-pick-app</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-ios|AnyCPU'">
	  <ApplicationId>jp.co.tozan.shift-pick-app</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-ios|AnyCPU'">
	  <ApplicationId>jp.co.tozan.shift-pick-app</ApplicationId>
	</PropertyGroup>

	<ItemGroup>
		<!-- アプリアイコン設定：
					Color：iOS は背景色がないと透明扱いになり App Store Connect の検証でエラーになる
					ForegroundScale：Android のアダプティブアイコンは周囲が切り取られるため、ロゴ全体がセーフゾーンに入るよう縮小 -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" ForegroundScale="0.5" />

		<!-- スプラッシュスクリーン設定：画像はアプリアイコンを3/4に縮小したもの（Androidの角丸による端の途切れを防ぐため）
					BaseSize：未指定だと iOS で画像が表示されない -->
		<MauiSplashScreen Include="Resources\Splash\appicon.png" Color="#00245B" BaseSize="128,128" />

		<!-- 画像（サブフォルダー含む。出力はファイル名のみで参照、同名ファイル不可） -->
		<MauiImage Include="Resources\Images\**" />

		<!-- カスタムフォント -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw アセット（"Resources\Raw\" を除いたパスで参照） -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="12.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="8.0.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.20" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Plugin.Maui.Audio" Version="2.1.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.8.116" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.7" />
	</ItemGroup>

</Project>
