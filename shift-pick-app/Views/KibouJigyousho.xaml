<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:shift_pick_app.ViewModels"
             xmlns:models="clr-namespace:shift_pick_app.Models"
             xmlns:shared="clr-namespace:shift_pick_app.Views.Shared"
             x:Class="shift_pick_app.Views.KibouJigyousho"
             x:DataType="vm:KibouJigyoushoViewModel"
             Title="希望事業所">

    <Grid>
        <!-- 1画面目：探し方を2つの区画（見出し＋カード）で並べる。現在地から / 都道府県から -->
        <ScrollView IsVisible="{Binding IsPrefectureView}">
            <VerticalStackLayout Padding="12" Spacing="12">

                <!-- 現在地から探す：都道府県と同格の選択肢のため塗りの主ボタンにしない -->
                <Label Text="現在地から探す" Style="{StaticResource InputLabel}" Margin="4,0" />
                <Border Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="現在地から近い順に事業所を表示します。"
                               FontSize="14"
                               TextColor="{DynamicResource OnSurfaceVariant}" />
                        <Button Text="近くの事業所を探す"
                                shared:ButtonIcon.Glyph="&#xf3c5;"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectByGpsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 区画の間は区画内より広く空ける -->
                <Label Text="都道府県から探す" Style="{StaticResource InputLabel}" Margin="4,8,4,0" />

                <!-- 都道府県カード（地方ごと・3列）：高さはコードビハインドで設定 -->
                <Border x:Name="prefectureCard" Style="{StaticResource Card}" Padding="8">
                    <CollectionView ItemsSource="{Binding PrefectureGroups}"
                                    IsGrouped="True"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <!-- 地方の見出し（Android は1行全体を使う） -->
                        <CollectionView.GroupHeaderTemplate>
                            <DataTemplate x:DataType="models:PrefectureGroup">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource InputLabel}"
                                       FontSize="14"
                                       Padding="4,8,4,0" />
                            </DataTemplate>
                        </CollectionView.GroupHeaderTemplate>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Prefecture">
                                <!-- タップでその都道府県の事業所（2画面目）を表示 -->
                                <Border Padding="8"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="2"
                                        Stroke="{DynamicResource OutlineVariant}"
                                        BackgroundColor="{DynamicResource SurfaceContainer}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                            <Setter Property="Opacity" Value="0.38" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KibouJigyoushoViewModel}},
                                                                                Path=SelectPrefectureCommand,
                                                                                x:DataType=vm:KibouJigyoushoViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Image Source="{Binding Image}"
                                               Aspect="AspectFit"
                                               HeightRequest="88" />
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 2画面目：希望の事業所（本体スクロール ＋ 下部固定の保存） -->
        <Grid IsVisible="{Binding IsOfficeView}" RowDefinitions="*,Auto">
            <ScrollView>
                <VerticalStackLayout Padding="12" Spacing="12">

                    <Label Text="{Binding OfficeListTitle}" Style="{StaticResource InputLabel}" Margin="4,0" />

                    <!-- 並び順：都道府県から = 事業所ID順 / 現在地から = 近い順（初期値） -->
                    <Border Style="{StaticResource SegmentTrack}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <Button Text="事業所ID順"
                                    Style="{StaticResource SegmentButton}"
                                    Command="{Binding SortByIdCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSortByDistance}" Value="False">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Tertiary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource OnTertiary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Grid.Column="1"
                                    Text="近い順"
                                    Style="{StaticResource SegmentButton}"
                                    Command="{Binding SortByDistanceCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSortByDistance}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Tertiary}" />
                                        <Setter Property="TextColor" Value="{DynamicResource OnTertiary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 事業所リスト：高さはコードビハインドで画面の約55%に設定 -->
                    <Border x:Name="officeCard" Style="{StaticResource Card}" Padding="0">
                        <CollectionView ItemsSource="{Binding Offices}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Office">
                                    <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="16" />
                                                <Label Text="{Binding City}" FontSize="14" TextColor="{DynamicResource OnSurfaceVariant}" />
                                            </VerticalStackLayout>
                                            <!-- 距離：近い順のときだけ表示 -->
                                            <Label Grid.Column="1"
                                                   Text="{Binding DistanceText}"
                                                   FontSize="14"
                                                   TextColor="{DynamicResource OnSurfaceVariant}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:KibouJigyoushoViewModel}}, Path=IsSortByDistance, x:DataType=vm:KibouJigyoushoViewModel}" />
                                        </Grid>
                                        <!-- チェックボックス代わり：未選択 Secondary「選択」/ 選択 Primary「選択中」。角なしで縦に連結 -->
                                        <Button Grid.Column="1"
                                                Text="選択"
                                                CornerRadius="0"
                                                FontSize="16"
                                                Padding="4,10"
                                                BackgroundColor="{DynamicResource SecondaryContainer}"
                                                TextColor="{DynamicResource OnSecondaryContainer}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KibouJigyoushoViewModel}}, Path=ToggleOfficeCommand, x:DataType=vm:KibouJigyoushoViewModel}"
                                                CommandParameter="{Binding .}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Text" Value="選択中" />
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                                                    <Setter Property="TextColor" Value="{DynamicResource OnPrimary}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <!-- 選択中の希望事業所（他の都道府県で選んだ事業所も含む）：1行に収まらなければ「すべて表示」 -->
                    <VerticalStackLayout Margin="4,0">
                        <Label Text="{Binding PreferredTitle}" Style="{StaticResource InputLabel}" />
                        <shared:ExpandableLabel Text="{Binding PreferredOffices}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- 下部固定：エラー + 選択解除 / 保存 -->
            <VerticalStackLayout Grid.Row="1">
                <BoxView HeightRequest="1" />
                <VerticalStackLayout Padding="12,8,12,12" Spacing="8">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{DynamicResource Error}"
                           IsVisible="{Binding IsErrorMessageVisible}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Text="選択解除"
                                shared:ButtonIcon.Glyph="&#xf12d;"
                                Style="{StaticResource TextButton}"
                                TextColor="{DynamicResource Tertiary}"
                                Command="{Binding ClearSelectionCommand}" />
                        <Button Grid.Column="1"
                                Text="保存"
                                shared:ButtonIcon.Glyph="&#xf02e;"
                                Command="{Binding RegisterCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <shared:LoadingOverlay IsVisible="{Binding IsBusy}" Message="{Binding BusyMessage}" />
    </Grid>
</ContentPage>
