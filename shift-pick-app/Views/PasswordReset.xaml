<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:shift_pick_app.ViewModels"
             x:Class="shift_pick_app.Views.PasswordReset"
             x:DataType="vm:PasswordResetViewModel"
             NavigationPage.HasBackButton="False"
             Title="パスワードリセット">

    <ScrollView>
        <Border Style="{StaticResource Card}" Margin="16" VerticalOptions="Start">
            <VerticalStackLayout Spacing="8">

                <!-- ユーザーID：ケース2-1は入力、それ以外は表示のみ -->
                <Label Text="ユーザーID" Style="{StaticResource InputLabel}" />
                <Border Style="{StaticResource InputBorder}" IsVisible="{Binding IsUserIdEditable}">
                    <Entry Text="{Binding UserId}"
                           Keyboard="Email"
                           Placeholder="メールアドレス"
                           IsTextPredictionEnabled="False"
                           FontSize="20" />
                </Border>
                <Label Text="{Binding UserId}"
                       IsVisible="{Binding IsUserIdReadOnly}"
                       FontSize="20"
                       Padding="12,0,12,8" />

                <!-- 初期パスワード：ケース1のみ -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsInitialPasswordVisible}">
                    <Label Text="初期パスワード" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding InitialPassword}" IsPassword="True" FontSize="20" />
                    </Border>
                </VerticalStackLayout>

                <!-- 新規パスワード + 確認：ケース1・ケース2-2 -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsNewPasswordVisible}">
                    <Label Text="新規パスワード" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding NewPassword}" IsPassword="True" FontSize="20" />
                    </Border>

                    <Label Text="新規パスワード確認" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding ConfirmPassword}" IsPassword="True" FontSize="20" />
                    </Border>
                </VerticalStackLayout>

                <!-- エラーメッセージ -->
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{DynamicResource Error}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <!-- 戻る / 送信・登録 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="戻る"
                            Command="{Binding BackCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="1"
                            Text="{Binding SubmitText}"
                            Command="{Binding SubmitCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
