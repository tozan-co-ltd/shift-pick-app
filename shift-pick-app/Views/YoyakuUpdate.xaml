<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:shift_pick_app.ViewModels"
             xmlns:models="clr-namespace:shift_pick_app.Models"
             xmlns:shared="clr-namespace:shift_pick_app.Views.Shared"
             x:Class="shift_pick_app.Views.YoyakuUpdate"
             x:DataType="vm:YoyakuUpdateViewModel"
             Title="応募登録">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="12" Spacing="12">

                <!-- ユーザーID -->
                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="ユーザーID"
                               Style="{StaticResource InputLabel}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding UserId}"
                               FontSize="18"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- 予約内容テーブル：高さはコードビハインドで画面の約55%に設定 -->
                <Border x:Name="tableCard" Style="{StaticResource Card}" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <!-- ヘッダー（固定） -->
                        <Grid ColumnDefinitions="*,*"
                              Padding="0,12"
                              BackgroundColor="{DynamicResource SurfaceContainerHigh}">
                            <Label Text="年月日" Style="{StaticResource InputLabel}" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="事業所" Style="{StaticResource InputLabel}" HorizontalOptions="Center" />
                        </Grid>

                        <!-- 本体（スクロール、行の下に区切り線） -->
                        <CollectionView Grid.Row="1" ItemsSource="{Binding Slots}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:YoyakuSlot">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,1">
                                        <Label Text="{Binding WorkDateFullText}"
                                               FontSize="16"
                                               Padding="0,14"
                                               HorizontalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding OfficeName}"
                                               FontSize="16"
                                               Padding="8,14"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center" />
                                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <!-- 登録（戻るはナビゲーションバーの戻るボタン） -->
                <Button Text="登録"
                        Command="{Binding RegisterCommand}"
                        HorizontalOptions="Center"
                        WidthRequest="200" />
            </VerticalStackLayout>
        </ScrollView>

        <shared:LoadingOverlay IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
